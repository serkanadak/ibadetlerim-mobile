{
  "expo": {
    "name": "İbadetlerim",
    "slug": "ibadetlerim",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "ibadetlerim",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#d9e3d0"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.serkanadak.ibadetlerim",
      "buildNumber": "1.0.0"
    },
    "android": {
      "package": "com.serkanadak.ibadetlerim",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#d9e3d0"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "baseUrl": "/Vocabulary/ibadet-takip"
    },
    "extra": {
      "description": "Sünni itikat (Hanefi fıkhı) esas alınarak farz, vacip ve sünnet ibadetleri günlük olarak işaretleyip takip eden checklist uygulaması."
    }
  }
}